# Local secrets override - copy this file to application-secrets.properties
# (which is gitignored) and fill in real values. Never commit actual secrets.
#
# These key names must match the ${...} placeholders in application.properties exactly
# (e.g. spring.datasource.password=${DB_PASSWORD:postgres} means the key here must be
# DB_PASSWORD, not something else - Spring only fills in a placeholder if the key matches).
#
# Usage:
#   copy src\main\resources\application-secrets.properties.example src\main\resources\application-secrets.properties
#   (then edit application-secrets.properties with real values)
#   mvn spring-boot:run "-Dspring-boot.run.profiles=secrets"

JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
DB_PASSWORD=replace-with-real-db-password

# Only needed if any of these differ from the defaults in application.properties
# (DB_HOST=localhost, DB_PORT=5432, DB_NAME=sawiya_auth_db, DB_USERNAME=postgres).
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sawiya_auth_db
# DB_USERNAME=postgres
