# Local secrets override - copy this file to application-secrets.properties
# (which is gitignored) and fill in real values. Never commit actual secrets.
#
# These key names must match the ${...} placeholders in application.properties exactly
# (e.g. spring.datasource.password=${DB_PASSWORD} means the key here must be DB_PASSWORD,
# not something else - Spring only fills in a placeholder if the key matches).
#
# JWT_SECRET, DB_URL, DB_USERNAME, and DB_PASSWORD have NO default in application.properties
# on purpose - the app will refuse to start without them, rather than silently running with
# a dev placeholder secret. All four are required below.
#
# Usage:
#   copy src\main\resources\application-secrets.properties.example src\main\resources\application-secrets.properties
#   (then edit application-secrets.properties with real values)
#   mvn spring-boot:run "-Dspring-boot.run.profiles=secrets"

JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
DB_URL=jdbc:postgresql://localhost:5432/sawiya_auth_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-real-db-password

# Everything below already has a working default in application.properties - only
# uncomment and override if your local setup genuinely needs something different.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# ACCESS_TOKEN_EXPIRY_MIN=15
# REFRESH_TOKEN_EXPIRY_DAYS=7
# COOKIE_SECURE=false
# CB_SLIDING_WINDOW_SIZE=10
# CB_MINIMUM_CALLS=5
# CB_FAILURE_RATE_THRESHOLD=50
# CB_WAIT_DURATION_OPEN=10s
# CB_HALF_OPEN_CALLS=3
# CB_AUTO_TRANSITION_HALF_OPEN=true
